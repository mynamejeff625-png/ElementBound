rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // This document contains authoritative state and player UIDs. It is server-only.
      allow read, write: if false;

      // Public room metadata must be stored separately from authoritative state.
      match /metadata/{document} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /views/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
