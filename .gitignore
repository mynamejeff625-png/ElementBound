# Element Bound — untracked and generated files Git should ignore.
# This does not protect files that are already tracked or force-added with
# `git add -f`. Always review `git status` and the staged diff before committing.

# Dependencies (reinstalled with `npm ci`)
node_modules/

# Secrets — never commit these
.env
.env.*
!.env.example
*service-account*.json
*firebase-adminsdk*.json
*.pem
*.key

# Firebase emulator and tool logs
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
.firebase/

# Vercel local config
.vercel/

# General logs and debug output
npm-debug.log*
*.log
coverage/

# OS and editor clutter
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
